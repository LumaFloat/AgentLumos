{
  "name": "agentlumos",
  "version": "0.5.0",
  "description": "Turn keyboard indicator LEDs into status lights for AI coding agents.",
  "license": "Apache-2.0",
  "author": "LumaFloat",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "codex",
    "claude-code",
    "keyboard",
    "led",
    "status-indicator",
    "cli",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LumaFloat/AgentLumos.git"
  },
  "bugs": {
    "url": "https://github.com/LumaFloat/AgentLumos/issues"
  },
  "homepage": "https://github.com/LumaFloat/AgentLumos#readme",
  "bin": {
    "lumos": "./dist/cli/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "koffi": "^3.0.2"
  }
}
